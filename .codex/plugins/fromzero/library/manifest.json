        "fz-context",
        "fz-spec",
        "fz-plan",
        "fz-security",
        "fz-release"
      ],
      "packagedPath": "library/resources/supabase.md",
      "requiredEnvExample": [
        "NEXT_PUBLIC_SUPABASE_URL",
