{
  "name": "from-zero-framework",
  "version": "7.4.0",
  "private": true,
  "description": "Reusable multi-tenant SaaS framework base.",
  "license": "UNLICENSED",
  "packageManager": "npm@11.14.0",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11.14.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "verify:stack": "npm ls --depth=0",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "sonar:doctor": "node scripts/sonarqube.mjs doctor",
    "sonar:status": "node scripts/sonarqube.mjs status",
    "sonar:issues": "node scripts/sonarqube.mjs issues",
    "sonar:gate": "node scripts/sonarqube.mjs gate",
    "sonar:scan": "node scripts/sonarqube.mjs scan",
    "check": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run verify:stack"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "inngest": "4.7.0",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "next-intl": "4.13.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.0",
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "25.9.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "supabase": "^2.107.0",
    "tailwindcss": "4.3.1",
    "typescript": "6.0.3",
    "vitest": "4.1.9"
  },
  "overrides": {
    "postcss": "8.5.15"
  }
}
