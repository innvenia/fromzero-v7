{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp",
      "disabled": true
    },
    "sonarqube": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "SONARQUBE_TOKEN",
        "-e",
        "SONARQUBE_ORG",
        "-e",
        "SONARQUBE_URL",
        "mcp/sonarqube",
        "stdio"
      ],
      "env": {
        "SONARQUBE_ORG": "",
        "SONARQUBE_URL": "https://sonarqube.innvenia.ai"
      },
      "disabled": true,
      "disabledTools": [
        "change_sonar_issue_status",
        "get_system_health",
        "get_system_info",
        "get_system_logs",
        "ping_system",
        "get_system_status",
        "create_webhook",
        "list_webhooks",
        "get_raw_source",
        "get_scm_info"
      ],
      "autoApprove": []
    }
  }
}
