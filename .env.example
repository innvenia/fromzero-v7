# From Zero Framework v7.4
# Copiar a .env.local o al store seguro del entorno.
# No colocar secretos reales en este archivo versionado.

# Aplicacion
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api/v1
AUTH_URL=http://localhost:3000
AUTH_SECRET=__replace_with_generated_secret__

# Supabase
NEXT_PUBLIC_SUPABASE_URL=__replace_with_supabase_project_url__
NEXT_PUBLIC_SUPABASE_ANON_KEY=__replace_with_supabase_anon_key__
SUPABASE_SERVICE_ROLE_KEY=__replace_with_server_only_service_role_key__
DATABASE_URL=__replace_with_postgres_connection_url__
SUPABASE_ACCESS_TOKEN=__replace_only_if_mcp_or_cli_is_approved__

# Billing
STRIPE_PUBLISHABLE_KEY=__replace_if_billing_is_enabled__
STRIPE_SECRET_KEY=__replace_if_billing_is_enabled__
STRIPE_WEBHOOK_SECRET=__replace_if_billing_is_enabled__

# Email
RESEND_API_KEY=__replace_if_email_is_enabled__

# AI
AI_PROVIDER=openrouter
AI_MODEL_ID=google/gemma-4-26b-a4b-it:free
AI_DEFAULT_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_API_KEY=__replace_if_ai_is_enabled__

# Jobs
INNGEST_EVENT_KEY=__replace_if_inngest_is_enabled__
INNGEST_SIGNING_KEY=__replace_if_inngest_is_enabled__

# Cache opcional
REDIS_ENABLED=false
REDIS_URL=__replace_if_redis_is_enabled__

# Anti-abuso
RECAPTCHA_SITE_KEY=__replace_if_recaptcha_is_enabled__
RECAPTCHA_SECRET_KEY=__replace_if_recaptcha_is_enabled__

# Calidad y pruebas
SONAR_HOST_URL=__replace_if_sonarqube_is_enabled__
SONAR_PROJECT_KEY=__replace_if_sonarqube_is_enabled__
SONAR_TOKEN=__replace_if_sonarqube_is_enabled__
SONARQUBE_URL=__replace_outside_repo_for_mcp__
SONARQUBE_PROJECT_KEY=__replace_outside_repo_for_mcp__
SONARQUBE_TOKEN=__replace_outside_repo_for_mcp__
SONARQUBE_READ_ONLY=true
TELEMETRY_DISABLED=true
PLAYWRIGHT_BASE_URL=http://localhost:3000
K6_BASE_URL=__replace_with_staging_base_url__
TEST_BASE_URL=http://localhost:3000
